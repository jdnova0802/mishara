# Gate API — External commercial layer (proxies Velaru engine)
GATE_SECRET_KEY=change-me
GATE_DB_PATH=./gate.db

# Velaru fuse backend
VELARU_API_URL=https://velaru.onrender.com

# Stripe (test keys OK for launch). Dollar amounts live ONLY in commerce/ladder.json.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...              # Pro subscription (match ladder)
STRIPE_INSTALL_PRICE_ID=price_...        # install one-time (match ladder)
STRIPE_BIND_ROOM_PRICE_ID=price_...      # Bind Room → ladder id bind_room
STRIPE_WELD_PRICE_ID=price_...           # operator weld → ladder id operator_weld
STRIPE_FLOOR_PRICE_ID=price_...          # operator floor → ladder id operator_floor

# Public URL for checkout redirects + well-known ads.
# Laptop: localhost is fine with GATE_DEV_MODE=1.
# Render: set https://YOUR_SERVICE.onrender.com — or leave unset and
# Gate lifts RENDER_EXTERNAL_URL automatically. Localhost in prod → /health 503.
GATE_PUBLIC_URL=http://localhost:5001
# GATE_ALLOW_LOCAL=0

# Optional display overrides — omit in prod so commerce/ladder.json is sole SSOT.
# GATE_PRO_PRICE_LABEL=
# GATE_INSTALL_PRICE_LABEL=
# GATE_INSTALL_PRICE_CENTS=
GATE_INSTALL_SLOTS=2                   # max paid installs per month
# GATE_BIND_ROOM_PRICE_LABEL=
# GATE_BIND_ROOM_PRICE_CENTS=
# GATE_WELD_PRICE_LABEL=
# GATE_WELD_PRICE_CENTS=
# GATE_FLOOR_PRICE_LABEL=
# GATE_FLOOR_PRICE_CENTS=

GATE_CONTACT_EMAIL=hello@velaru.xyz

# Persistent DB (Render disk: /var/data/gate.db — never /tmp)
# GATE_DB_PATH=/var/data/gate.db

# Google Ads / GA4 tag (public in page source once set). Example: AW-18402962939
GATE_GA_ID=

# Meta Pixel (optional)
GATE_META_PIXEL_ID=

# Discord/Slack incoming webhook — fires when install or Pro pays
GATE_NOTIFY_WEBHOOK=

# Secret token for GET /ops/orders?token=...
GATE_OPS_TOKEN=

# Set 1 to allow signup/checkout without Stripe (dev only)
GATE_DEV_MODE=0

# OCSP hop timeout (seconds). Timeout is HALT, never LIVE.
GATE_OCSP_TIMEOUT=5
