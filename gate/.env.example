# Gate API — External commercial layer (proxies Velaru engine)
GATE_SECRET_KEY=change-me
GATE_DB_PATH=./gate.db

# Velaru fuse backend
VELARU_API_URL=https://velaru.onrender.com

# Stripe (test keys OK for launch)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...              # $99/mo Pro subscription
STRIPE_INSTALL_PRICE_ID=price_...        # $2,500 one-time 48hr install
STRIPE_BIND_ROOM_PRICE_ID=price_...      # $1,750 one-time Bind Room officer pack

# Public URL for checkout redirects + well-known ads.
# Laptop: localhost is fine with GATE_DEV_MODE=1.
# Render: set https://YOUR_SERVICE.onrender.com — or leave unset and
# Gate lifts RENDER_EXTERNAL_URL automatically. Localhost in prod → /health 503.
GATE_PUBLIC_URL=http://localhost:5001
# GATE_ALLOW_LOCAL=0

# Pricing labels (display only)
GATE_PRO_PRICE_LABEL=$99/mo
GATE_INSTALL_PRICE_LABEL=$2,500
GATE_INSTALL_PRICE_CENTS=250000
GATE_INSTALL_SLOTS=2                   # max paid installs per month
GATE_BIND_ROOM_PRICE_LABEL=$1,750
GATE_BIND_ROOM_PRICE_CENTS=175000

GATE_CONTACT_EMAIL=hello@velaru.xyz

# Persistent DB (Render disk: /var/data/gate.db — never /tmp)
# GATE_DB_PATH=/var/data/gate.db

# Discord/Slack incoming webhook — fires when install or Pro pays
GATE_NOTIFY_WEBHOOK=

# Secret token for GET /ops/orders?token=...
GATE_OPS_TOKEN=

# Set 1 to allow signup/checkout without Stripe (dev only)
GATE_DEV_MODE=0

# OCSP hop timeout (seconds). Timeout is HALT, never LIVE.
GATE_OCSP_TIMEOUT=5
